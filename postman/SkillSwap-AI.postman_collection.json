            },
            "url": "{{baseUrl}}/ai/study-plan"
          }
        },
        {
          "name": "Mentor Recommendation (Smart Matching)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
